async function refreshState(selectName = null) {
  appState = await api("/api/state");
  const tbtn = document.getElementById("toggleBtn");
  const active = appState.state.active_profile || "";
  tbtn.textContent = appState.running ? (active ? `EQ: ON (${active})` : "EQ: ON") : "EQ: OFF (Bypassed)";
