  setStatus("Applying PipeWire filter-chain...");
  const res = await api("/api/apply", { name });
  setStatus(res.message); await refreshState(name);
}

async function toggleEQ() {
  setStatus("Updating PipeWire filter-chain...");
  const res = await api("/api/toggle_eq", { name: document.getElementById("profileSel").value });
  setStatus(res.message); await refreshState();
}

