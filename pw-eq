  body { margin:0; background:var(--bg); color:var(--text); font:13px/1.45 var(--sans); }
  .wrap { max-width:1040px; margin:0 auto; padding:14px 16px; display:flex; flex-direction:column; gap:10px; }
  .card { background:var(--surf); border-radius:14px; padding:12px 14px; }
  .row { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
  .row + .row { margin-top:8px; }
  .grow { flex:1 1 200px; min-width:140px; }
  .lbl { color:var(--muted); font-size:12px; font-weight:600; }
  select, input[type="number"], input[type="text"], textarea {
    background:var(--surf2); color:var(--text); border:1px solid var(--outline);
    border-radius:10px; padding:6px 10px; font:inherit; outline:none;
  }
  select:focus, input:focus, textarea:focus { border-color:var(--primary); }
  button {
    border:0; border-radius:18px; padding:7px 14px; font:600 12.5px var(--sans);
    background:var(--surf2); color:var(--text); cursor:pointer; transition:.12s background;
  }
  button:hover { background:var(--surf3); }
  button.primary { background:var(--primary); color:var(--on-primary); }
  button.primary:hover { filter:brightness(1.06); }
  button.tonal { background:var(--primary-cont); color:var(--on-primary-cont); }
  button.on { background:var(--ok-cont); color:var(--ok); }
  button.off { background:var(--surf3); color:var(--muted); }
  button.danger:hover { color:var(--err); }
  label.chk { display:inline-flex; align-items:center; gap:6px; cursor:pointer; color:var(--muted); font-size:12.5px; }
  input[type="checkbox"] { accent-color:var(--primary); width:15px; height:15px; cursor:pointer; }
  svg { width:100%; height:290px; display:block; background:var(--bg); border-radius:10px; }
  .warn { background:var(--warn-cont); color:var(--warn); border-radius:10px; padding:7px 10px; font-size:12px; margin-bottom:8px; }
  .tabs { display:inline-flex; background:var(--surf3); border-radius:18px; padding:3px; gap:2px; margin-bottom:8px; }
  .tab { padding:5px 14px; border-radius:15px; font:600 12.5px var(--sans); color:var(--muted); cursor:pointer; border:0; background:transparent; }
  .tab:hover { color:var(--text); background:transparent; }
  .tab.active { background:var(--primary); color:var(--on-primary); }
  .pane { display:none; } .pane.active { display:block; }
  table { width:100%; border-collapse:collapse; font-size:12.5px; }
  th, td { padding:6px 8px; text-align:left; border-bottom:1px solid var(--surf2); }
  th { color:var(--muted); font-weight:600; }
  td.num { font-family:var(--mono); text-align:right; }
  tr:hover td { background:var(--surf2); }
  textarea { width:100%; min-height:240px; font:12.5px/1.5 var(--mono); resize:vertical; }
  .foot { display:flex; justify-content:space-between; color:var(--muted); font-size:12px; padding:2px 4px; }
  body.drag { outline:2px dashed var(--primary); outline-offset:-6px; }
  dialog { background:var(--surf); color:var(--text); border:1px solid var(--outline); border-radius:14px; padding:16px; width:min(540px, 92vw); }
  dialog::backdrop { background:rgba(0,0,0,.6); }
</style>
</head>
<body>
<div class="wrap">
  <div class="card">
    <div class="row">
      <button id="toggleBtn" class="off" onclick="toggleEQ()">EQ: OFF</button>
      <span class="lbl">Profile</span>
      <select id="profileSel" class="grow" onchange="loadProfile(this.value)"></select>
      <button class="primary" onclick="applySelected()">Apply &amp; Activate</button>
      <button class="tonal" onclick="document.getElementById('fileInput').click()">Import</button>
      <button class="tonal" onclick="pastePreset()">Paste</button>
      <button class="danger" onclick="deleteProfile()">Delete</button>
      <input id="fileInput" type="file" accept=".txt,text/plain" hidden onchange="importFileObj(this.files[0]);this.value=''">
    </div>
    <div class="row">
      <span class="lbl">Target Sink</span>
      <select id="sinkSel" class="grow"></select>
      <label class="chk" title="WirePlumber Smart Filter: keeps hardware sink as system default for a single hardware volume slider.">
        <input id="smartCb" type="checkbox"> Smart Auto-Follow
      </label>
      <button onclick="saveSettings()">Save</button>
      <button class="danger" onclick="quitApp()">Quit</button>
    </div>
  </div>

  <div class="card" style="padding:10px;">
    <svg id="plot" viewBox="0 0 900 290" onmousemove="onPlotHover(event)" onmouseleave="clearHover()"></svg>
  </div>

  <div class="card">
    <div id="warnBox" class="warn" hidden></div>
    <div class="tabs">
      <button class="tab active" onclick="switchTab(0)">Bands</button>
      <button class="tab" onclick="switchTab(1)">Raw Editor</button>
      <button class="tab" onclick="switchTab(2)">PipeWire Config</button>
    </div>

    <div class="pane active">
      <div class="row" style="margin-bottom:8px;">
        <span class="lbl">Preamp (dB)</span>
        <input id="preampIn" type="number" step="0.1" style="width:90px;font-family:var(--mono)">
        <button class="tonal" onclick="setPreamp()">Set</button>
        <button onclick="autoPreamp()">Auto Anti-Clip</button>
        <span id="bandCount" class="lbl" style="margin-left:auto;"></span>
      </div>
      <div style="max-height:280px;overflow:auto;">
        <table>
          <thead><tr><th>#</th><th>On</th><th>Type</th><th style="text-align:right">Freq (Hz)</th><th style="text-align:right">Gain (dB)</th><th style="text-align:right">Q</th></tr></thead>
          <tbody id="bandsBody"></tbody>
        </table>
      </div>
    </div>

    <div class="pane">
      <textarea id="rawEdit" spellcheck="false"></textarea>
      <div class="row" style="margin-top:8px;">
        <button class="primary" onclick="saveRawAndApply()">Save Raw &amp; Apply</button>
        <span class="lbl">Tip: drag &amp; drop any AutoEq / EqualizerAPO .txt file anywhere on this window.</span>
      </div>
    </div>

    <div class="pane">
      <div class="lbl" id="infoMeta" style="margin-bottom:6px;"></div>
      <textarea id="confPreview" readonly spellcheck="false"></textarea>
    </div>
  </div>

  <div class="foot">
    <span id="statusMsg">Ready.</span>
    <span id="hoverTxt"></span>
  </div>
</div>

<dialog id="pasteDlg">
  <div style="font-weight:600;margin-bottom:8px;">Paste AutoEq / EqualizerAPO Preset</div>
  <input id="pasteName" type="text" placeholder="Profile Name" style="width:100%;margin-bottom:8px;">
  <textarea id="pasteBody" placeholder="Preamp: -6.0 dB&#10;Filter 1: ON PK Fc 105 Hz Gain 3.2 dB Q 1.41" style="min-height:180px;"></textarea>
  <div class="row" style="justify-content:flex-end;margin-top:10px;">
    <button onclick="pasteDlg.close()">Cancel</button>
    <button class="primary" onclick="submitPasteModal()">Save &amp; Apply</button>
  </div>
</dialog>

<script>
const API_TOKEN = __API_TOKEN_JSON__;
let currentProf = null;
let dragDepth = 0;
const pasteDlg = document.getElementById("pasteDlg");

function escHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c]));
}

async function api(url, body = null) {
  const headers = { "X-PW-EQ-Token": API_TOKEN };
  const opts = { headers };
  if (body !== null) {
    headers["Content-Type"] = "application/json";
    opts.method = "POST";
    opts.body = JSON.stringify(body);
  }
  const r = await fetch(url, opts);
  let data = null;
  try { data = await r.json(); } catch {}
  if (!r.ok) {
    const msg = (data && data.message) || r.statusText || "Request failed";
    setStatus("Error: " + msg);
    throw new Error(msg);
  }
  return data;
}

function setStatus(msg) { document.getElementById("statusMsg").textContent = msg; }
function clearHover() { document.getElementById("hoverTxt").textContent = ""; }

function switchTab(idx) {
  document.querySelectorAll(".tab").forEach((e, i) => e.classList.toggle("active", i === idx));
  document.querySelectorAll(".pane").forEach((e, i) => e.classList.toggle("active", i === idx));
}

function clearProfileUI() {
  currentProf = null;
  document.getElementById("plot").innerHTML = "";
  document.getElementById("bandsBody").innerHTML = "";
  document.getElementById("rawEdit").value = "";
  document.getElementById("preampIn").value = "0";
  document.getElementById("bandCount").textContent = "0 bands";
  document.getElementById("warnBox").hidden = true;
}

async function refreshState() {
  const st = await api("/api/state");
  const btn = document.getElementById("toggleBtn");
  btn.textContent = st.eq_running ? "EQ: ON" : "EQ: OFF";
  btn.className = st.eq_running ? "on" : "off";

  const pSel = document.getElementById("profileSel");
  pSel.innerHTML = st.profiles.map(p => `<option value="${escHtml(p)}">${escHtml(p)}</option>`).join("");
  if (st.active_profile && st.profiles.includes(st.active_profile)) pSel.value = st.active_profile;

  const sSel = document.getElementById("sinkSel");
  sSel.innerHTML = `<option value="">Auto (follow system default)</option>` +
    st.sinks.map(s => `<option value="${escHtml(s.name)}">${escHtml(s.desc)} (${escHtml(s.name)})</option>`).join("");
  sSel.value = st.target_node || "";
  document.getElementById("smartCb").checked = !!st.smart_filter;
  document.getElementById("infoMeta").textContent =
    `Service: ${st.service_name} | Profiles: ${st.profiles_dir} | PipeWire Default: ${st.default_sink || "unknown"}`;
  document.getElementById("confPreview").value = st.active_conf || "(No active.conf yet. Click 'Apply & Activate'.)";

  if (st.active_profile) await loadProfile(st.active_profile);
  else clearProfileUI();
}

async function loadProfile(name) {
  if (!name) return clearProfileUI();
  renderProfile(await api("/api/profile?name=" + encodeURIComponent(name)));
}

function renderProfile(prof) {
  currentProf = prof;
  document.getElementById("preampIn").value = prof.preamp;
  document.getElementById("bandCount").textContent = `${prof.bands.filter(b => b.enabled).length}/${prof.bands.length} bands active`;
  document.getElementById("rawEdit").value = prof.raw_text;

  const wb = document.getElementById("warnBox");
  if (prof.warnings && prof.warnings.length) {
    wb.textContent = "Parse warnings: " + prof.warnings.join(" | ");
    wb.hidden = false;
  } else {
    wb.hidden = true;
  }

  document.getElementById("bandsBody").innerHTML = prof.bands.map((b, i) => `
    <tr>
      <td>${i + 1}</td>
      <td><input type="checkbox" ${b.enabled ? "checked" : ""} onchange="toggleBand(${i})"></td>
      <td>${escHtml(b.type)}</td>
      <td class="num">${escHtml(b.freq)}</td>
      <td class="num">${b.no_gain ? "-" : escHtml(b.gain)}</td>
      <td class="num">${escHtml(b.q)}</td>
    </tr>`).join("");
  drawPlot(prof);
}

function drawPlot(prof) {
  const svg = document.getElementById("plot");
  const W = 900, H = 290, pad = { l: 42, r: 16, t: 14, b: 26 }, pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
  const yMin = -18, yMax = 18;
  const xOf = f => pad.l + (Math.log10(f) - Math.log10(20)) / 3 * pw;
  const yOf = db => pad.t + (1 - (db - yMin) / (yMax - yMin)) * ph;

  let out = `<defs><clipPath id="plotClip"><rect x="${pad.l}" y="${pad.t}" width="${pw}" height="${ph}"/></clipPath></defs>`;
  for (let db = -18; db <= 18; db += 6) {
    const y = yOf(db);
    out += `<line x1="${pad.l}" y1="${y}" x2="${W - pad.r}" y2="${y}" stroke="${db === 0 ? "#4c5268" : "#222530"}" stroke-width="${db === 0 ? 1.5 : 1}"/>`;
    out += `<text x="${pad.l - 6}" y="${y + 4}" fill="#8e95aa" font-size="10.5" text-anchor="end">${db > 0 ? "+" + db : db}</text>`;
  }
  for (const f of [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000]) {
    const x = xOf(f);
    out += `<line x1="${x}" y1="${pad.t}" x2="${x}" y2="${H - pad.b}" stroke="#222530"/>`;
    out += `<text x="${x}" y="${H - 8}" fill="#8e95aa" font-size="10.5" text-anchor="middle">${f >= 1000 ? (f / 1000) + "k" : f}</text>`;
  }

  const pts = prof.curve.map(([f, db]) => `${xOf(f).toFixed(1)},${yOf(db).toFixed(1)}`);
  const y0 = yOf(0);
  out += `<g clip-path="url(#plotClip)">`;
  out += `<polygon points="${xOf(20).toFixed(1)},${y0.toFixed(1)} ${pts.join(" ")} ${xOf(20000).toFixed(1)},${y0.toFixed(1)}" fill="rgba(168,199,250,0.14)"/>`;
  out += `<polyline fill="none" stroke="#a8c7fa" stroke-width="2.4" points="${pts.join(" ")}"/>`;
  for (const b of prof.bands) {
    if (!b.enabled || !Number.isFinite(b.freq)) continue;
    const f = Math.min(20000, Math.max(20, b.freq));
    const g = b.no_gain ? 0 : (Number.isFinite(b.gain) ? b.gain : 0);
    out += `<circle cx="${xOf(f).toFixed(1)}" cy="${yOf(g).toFixed(1)}" r="3.5" fill="#7dd88b" opacity="0.85"/>`;
  }
  out += `</g>`;
  svg.innerHTML = out;
}

function onPlotHover(e) {
  if (!currentProf) return;
  const rect = document.getElementById("plot").getBoundingClientRect();
  if (!rect.width || !rect.height) return;
  const x = ((e.clientX - rect.left) / rect.width) * 900;
  const y = ((e.clientY - rect.top) / rect.height) * 290;
  const freq = Math.pow(10, Math.log10(20) + ((x - 42) / (900 - 58)) * 3);
  const db = 18 - ((y - 14) / (290 - 40)) * 36;
  document.getElementById("hoverTxt").textContent = (freq >= 20 && freq <= 20000) ? `${Math.round(freq)} Hz | ${db >= 0 ? "+" : ""}${db.toFixed(1)} dB` : "";
}

async function applySelected() {
  const name = document.getElementById("profileSel").value;
  if (!name) return setStatus("No profile selected.");
  try {
    setStatus((await api("/api/apply", { name })).message);
  } finally {
    await refreshState();
  }
}

async function toggleEQ() {
  const name = document.getElementById("profileSel").value;
  try {
    setStatus((await api("/api/toggle_eq", { name })).message);
  } finally {
    await refreshState();
  }
}

async function saveSettings() {
  setStatus((await api("/api/settings", {
    target_node: document.getElementById("sinkSel").value,
    smart_filter: document.getElementById("smartCb").checked
  })).message);
}

async function setPreamp() {
  if (!currentProf) return;
  const val = parseFloat(document.getElementById("preampIn").value);
  if (!Number.isFinite(val)) return setStatus("Invalid preamp value.");
  renderProfile(await api("/api/profile/preamp", { name: currentProf.name, preamp: val }));
  setStatus("Preamp updated (click Apply to activate).");
}

async function autoPreamp() {
  if (!currentProf) return;
  document.getElementById("preampIn").value = currentProf.recommended_preamp;
  await setPreamp();
}

async function toggleBand(idx) {
  if (!currentProf) return;
  renderProfile(await api("/api/profile/toggle_band", { name: currentProf.name, index: idx }));
  setStatus("Band toggled (click Apply to activate).");
}

async function saveAndApply(name, text) {
  try {
    setStatus((await api("/api/profile/save", { name, text })).message);
  } finally {
    await refreshState();
  }
}

async function saveRawAndApply() {
  const name = document.getElementById("profileSel").value || (currentProf ? currentProf.name : "Custom");
  await saveAndApply(name, document.getElementById("rawEdit").value);
}

async function importFileObj(file) {
  if (!file) return;
  if (file.size > 524288) return setStatus("Error: File exceeds 512 KiB limit.");
  const text = await file.text();
  const name = file.name.replace(/\.txt$/i, "");
  await saveAndApply(name, text);
}

function pastePreset() {
  document.getElementById("pasteName").value = "";
  document.getElementById("pasteBody").value = "";
  pasteDlg.showModal();
  document.getElementById("pasteName").focus();
}

async function submitPasteModal() {
  const name = document.getElementById("pasteName").value.trim() || "Pasted Preset";
  const text = document.getElementById("pasteBody").value;
  if (!text.trim()) return;
  pasteDlg.close();
  await saveAndApply(name, text);
}

async function deleteProfile() {
  const name = document.getElementById("profileSel").value;
  if (!name || !confirm(`Delete profile '${name}'?`)) return;
  try {
    setStatus((await api("/api/profile/delete", { name })).message);
  } finally {
    await refreshState();
  }
}

async function quitApp() {
  await api("/api/quit", {});
  setStatus("Server stopped. You can close this tab.");
}

document.body.addEventListener("dragenter", e => { e.preventDefault(); dragDepth++; document.body.classList.add("drag"); });
document.body.addEventListener("dragover", e => { e.preventDefault(); });
document.body.addEventListener("dragleave", () => { if (--dragDepth <= 0) { dragDepth = 0; document.body.classList.remove("drag"); } });
document.body.addEventListener("drop", e => { e.preventDefault(); dragDepth = 0; document.body.classList.remove("drag"); importFileObj(e.dataTransfer.files[0]); });

refreshState();
</script>
</body>
</html>
"""

PAGE_BYTES = HTML.replace("__API_TOKEN_JSON__", json.dumps(SESSION_TOKEN)).encode("utf-8")


def _serialize_profile(name: str) -> dict:
    p = load_profile(name)
    freqs, curve = compute_response_curve(p)
    return {
        "name": p.name,
        "preamp": p.preamp,
        "recommended_preamp": recommended_preamp(p),
        "raw_text": p.raw_text,
        "warnings": p.warnings,
        "curve": [[round(f, 1), round(db, 2)] for f, db in zip(freqs, curve)],
        "bands": [
            {
                "enabled": b.enabled, "type": b.raw_type, "freq": b.freq,
                "gain": b.gain, "q": round(b.q, 3), "no_gain": b.pw_type in NO_GAIN_TYPES,
            }
            for b in p.bands
        ],
    }


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def _send(self, body: bytes, ctype: str, status=HTTPStatus.OK):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, obj: dict, status=HTTPStatus.OK):
        self._send(json.dumps(obj).encode("utf-8"), "application/json; charset=utf-8", status)

    def _require_token(self) -> bool:
        tok = self.headers.get("X-PW-EQ-Token", "")
        if not secrets.compare_digest(tok, SESSION_TOKEN):
            self._send_json({"ok": False, "message": "Invalid or missing session token."}, HTTPStatus.FORBIDDEN)
            return False
        return True

    def _read_json(self) -> dict:
        try:
            length = int(self.headers.get("Content-Length", "0") or 0)
        except ValueError as e:
            raise ValueError("Invalid Content-Length.") from e
        if length < 0 or length > MAX_BODY_BYTES:
            raise ValueError("Request body size out of bounds.")
        raw = self.rfile.read(length) if length > 0 else b"{}"
        data = json.loads(raw.decode("utf-8"))
        if not isinstance(data, dict):
            raise ValueError("Expected JSON object.")
        return data

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        try:
            if parsed.path == "/":
                return self._send(PAGE_BYTES, "text/html; charset=utf-8")
            if parsed.path.startswith("/api/") and not self._require_token():
                return
            if parsed.path == "/api/state":
                st = load_state()
                sinks, default_sink = get_pw_sinks_and_default()
                profiles = list_profiles()
                active = st.get("active_profile", "")
                if active not in profiles:
                    active = profiles[0] if profiles else ""
                conf = ACTIVE_CONF.read_text(encoding="utf-8") if ACTIVE_CONF.exists() else ""
                return self._send_json({
                    "eq_running": is_eq_running(),
                    "profiles": profiles,
                    "active_profile": active,
                    "target_node": st.get("target_node", ""),
                    "smart_filter": st.get("smart_filter", True),
                    "sinks": [s for s in sinks if not is_eq_node(s["name"])],
                    "default_sink": default_sink,
                    "service_name": SERVICE_NAME,
                    "profiles_dir": str(PROFILES_DIR),
                    "active_conf": conf,
                })
            if parsed.path == "/api/profile":
                name = urllib.parse.parse_qs(parsed.query).get("name", [""])[0]
                return self._send_json(_serialize_profile(name))
            self._send(b"Not Found", "text/plain", HTTPStatus.NOT_FOUND)
        except FileNotFoundError:
            self._send_json({"ok": False, "message": "Profile not found."}, HTTPStatus.NOT_FOUND)
        except (ValueError, KeyError) as e:
            self._send_json({"ok": False, "message": str(e)}, HTTPStatus.BAD_REQUEST)

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._require_token():
            return
        try:
            body = self._read_json()

            if path == "/api/profile/save":
                name = str(body.get("name", "")).strip() or "Untitled"
                text = str(body.get("text", ""))
                saved_path = save_profile_text(name, text)
                ok, msg = apply_profile(saved_path.stem)
                return self._send_json({"ok": ok, "message": msg}, HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST)

            if path == "/api/profile/preamp":
                name = str(body["name"])
                preamp = float(body["preamp"])
                if not math.isfinite(preamp):
                    raise ValueError("Invalid preamp value.")
                p = load_profile(name)
                p.preamp = preamp
                save_profile_text(name, format_eq_text(p))
                return self._send_json(_serialize_profile(name))

            if path == "/api/profile/toggle_band":
                name = str(body["name"])
                idx = int(body["index"])
                p = load_profile(name)
                if not (0 <= idx < len(p.bands)):
                    raise ValueError("Band index out of range.")
                p.bands[idx].enabled = not p.bands[idx].enabled
                save_profile_text(name, format_eq_text(p))
                return self._send_json(_serialize_profile(name))

            if path == "/api/profile/delete":
                name = str(body.get("name", ""))
                delete_profile(name)
                return self._send_json({"ok": True, "message": f"Deleted '{name}'."})

            if path == "/api/apply":
                ok, msg = apply_profile(str(body.get("name", "")))
                return self._send_json({"ok": ok, "message": msg}, HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST)

            if path == "/api/toggle_eq":
                if is_eq_running():
                    ok, msg = stop_eq()
                else:
                    name = str(body.get("name", "")).strip()
                    if not name:
                        return self._send_json({"ok": False, "message": "No profile selected."}, HTTPStatus.BAD_REQUEST)
                    ok, msg = apply_profile(name)
                return self._send_json({"ok": ok, "message": msg}, HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST)

            if path == "/api/settings":
                st = load_state()
                st["target_node"] = str(body.get("target_node") or "")
                st["smart_filter"] = bool(body.get("smart_filter", True))
                save_state(st)
                return self._send_json({"ok": True, "message": "Settings saved (click Apply to activate)."})

            if path == "/api/quit":
                self._send_json({"ok": True, "message": "Shutting down."})
                t = threading.Timer(0.1, self.server.shutdown)
                t.daemon = True
                t.start()
                return

            self._send_json({"ok": False, "message": "Not Found"}, HTTPStatus.NOT_FOUND)
        except FileNotFoundError as e:
            self._send_json({"ok": False, "message": str(e) or "Not found."}, HTTPStatus.NOT_FOUND)
        except (ValueError, KeyError, json.JSONDecodeError) as e:
            self._send_json({"ok": False, "message": str(e)}, HTTPStatus.BAD_REQUEST)


def main():
    ap = argparse.ArgumentParser(description="PipeWire Parametric EQ")
    ap.add_argument("--port", type=int, default=0, help="Port to bind on 127.0.0.1 (default: random free port)")
    ap.add_argument("--no-browser", action="store_true", help="Do not open browser automatically")
    ap.add_argument("--cleanup", action="store_true", help="Stop/disable service and remove all pw-eq files")
    args = ap.parse_args()

    if args.cleanup:
        for line in cleanup():
            print(line)
        return

    if not (0 <= args.port <= 65535):
        ap.error("--port must be between 0 and 65535")

    ensure_dirs()
    ThreadingHTTPServer.daemon_threads = True
    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{srv.server_port}"
    print(f"PipeWire Parametric EQ UI running at {url} (Ctrl+C to quit)")
    if not args.no_browser:
        t = threading.Timer(0.2, lambda: webbrowser.open(url))
        t.daemon = True
        t.start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
