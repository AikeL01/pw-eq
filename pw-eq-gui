function drawPlot() {
  const svg = document.getElementById("plot");
  const W = 960, H = 220, PL = 42, PR = 12, PT = 12, PB = 24;
  const PW = W - PL - PR, PH = H - PT - PB;
  const xOf = f => PL + (Math.log10(Math.max(20, Math.min(20000, f))) - Math.log10(20)) / 3 * PW;
  const yOf = db => PT + (24 - Math.max(-24, Math.min(24, db))) / 48 * PH;

  let out = `<defs><linearGradient id="eqFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#38bdf8" stop-opacity="0.32"/><stop offset="100%" stop-color="#38bdf8" stop-opacity="0.02"/></linearGradient></defs>`;
  const fTicks = [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000];
  for (const f of fTicks) {
    const x = xOf(f).toFixed(1);
    const label = f >= 1000 ? `${f / 1000}k` : `${f}`;
    out += `<line x1="${x}" y1="${PT}" x2="${x}" y2="${H - PB}" stroke="#263348" stroke-width="1"/>`;
    out += `<text x="${x}" y="${H - 7}" text-anchor="middle" fill="#64748b" font-size="10">${label}</text>`;
  }
  const dTicks = [-24, -18, -12, -6, 0, 6, 12, 18, 24];
  for (const d of dTicks) {
    const y = yOf(d).toFixed(1);
    const zero = d === 0;
    out += `<line x1="${PL}" y1="${y}" x2="${W - PR}" y2="${y}" stroke="${zero ? "#475569" : "#263348"}" stroke-width="1"${zero ? ' stroke-dasharray="4 4"' : ""}/>`;
    out += `<text x="${PL - 6}" y="${y + 3}" text-anchor="end" fill="#64748b" font-size="10">${d > 0 ? "+" + d : d}</text>`;
  }

  if (currentProf && currentProf.freqs.length) {
    const pts = currentProf.freqs.map((f, i) => [xOf(f), yOf(currentProf.mags[i])]);
    const dPath = pts.map((p, i) => `${i ? "L" : "M"}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");
    const zeroY = yOf(0).toFixed(1);
    const areaD = `${dPath} L${pts[pts.length - 1][0].toFixed(1)},${zeroY} L${pts[0][0].toFixed(1)},${zeroY} Z`;
    out += `<path d="${areaD}" fill="url(#eqFill)"/>`;
    out += `<path d="${dPath}" fill="none" stroke="#38bdf8" stroke-width="2"/>`;
    for (const b of currentProf.bands) {
      if (!b.enabled || b.no_gain) continue;
      out += `<circle cx="${xOf(b.freq).toFixed(1)}" cy="${yOf(currentProf.preamp + b.gain).toFixed(1)}" r="3.5" fill="#7dd3fc" stroke="#0f172a" stroke-width="1.2"/>`;
    }
  }
  svg.innerHTML = out;
}

function onPlotHover(e) {
  if (!currentProf || !currentProf.freqs.length) return;
  const svg = document.getElementById("plot");
  const r = svg.getBoundingClientRect();
  const x = (e.clientX - r.left) / r.width * 960;
  const ratio = Math.max(0, Math.min(1, (x - 42) / (960 - 54)));
  const freq = 20 * Math.pow(1000, ratio);
  let best = 0, bestD = 1e9;
  currentProf.freqs.forEach((f, i) => { const d = Math.abs(f - freq); if (d < bestD) { bestD = d; best = i; } });
  const db = currentProf.mags[best];
  hoverText.textContent = `${freq >= 1000 ? (freq / 1000).toFixed(2) + " kHz" : Math.round(freq) + " Hz"}  |  ${db >= 0 ? "+" : ""}${db.toFixed(2)} dB`;
}

