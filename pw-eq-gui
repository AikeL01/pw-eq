async function refreshState(selectName = null) {
  const s = await api("/api/state"), tbtn = document.getElementById("toggleBtn"), active = s.state.active_profile || "";
  tbtn.textContent = s.running ? (active ? `EQ: ON (${active})` : "EQ: ON") : "EQ: OFF (Bypassed)";
