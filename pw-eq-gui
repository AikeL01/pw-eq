async function loadProfile(name) {
  if (!name) return;
  currentProf = await api(`/api/profile?name=${encodeURIComponent(name)}`);
  renderProfile(currentProf);
  setStatus(currentProf.warnings?.length ? currentProf.warnings[0] : `Loaded '${name}' (${currentProf.bands.length} bands)`);
}
function renderProfile(prof) {
  const tbody = document.getElementById("bandsBody"); tbody.innerHTML = "";
  if (!prof) { document.getElementById("rawEdit").value = ""; drawPlot(null); return; }
  document.getElementById("preampIn").value = prof.preamp.toFixed(2);
  document.getElementById("rawEdit").value = prof.raw_text;
  prof.bands.forEach((b, i) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td><input type="checkbox" ${b.enabled ? "checked" : ""} onchange="toggleBand(${i},this.checked)"></td><td>${b.raw_type}</td><td>${b.freq.toFixed(1)}</td><td>${b.has_gain ? (b.gain >= 0 ? "+" : "") + b.gain.toFixed(2) : "—"}</td><td>${b.q.toFixed(3)}</td>`;
    tbody.appendChild(tr);
  });
  drawPlot(prof);
}
function drawPlot(prof) {
  const svg = document.getElementById("plot"), W = 840, H = 230, pL = 44, pR = 16, pT = 20, pB = 26, pw = W - pL - pR, ph = H - pT - pB;
  let minDb = -15, maxDb = 15;
  if (prof?.curve.freqs.length) {
    const all = prof.curve.total_db.concat(prof.curve.raw_db);
    const span = Math.max(15, Math.ceil(Math.max(Math.abs(Math.max(...all)), Math.abs(Math.min(...all))) / 5) * 5);
    minDb = -span; maxDb = span;
  }
  svg._bounds = { pL, pT, pw, ph, minDb, maxDb };
  const xF = f => pL + pw * (Math.log10(Math.max(20, Math.min(20000, f)) / 20) / Math.log10(1000));
  const yD = d => pT + ph * (1 - (Math.max(minDb, Math.min(maxDb, d)) - minDb) / (maxDb - minDb));
  let out = "";
  for (const gf of [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000]) {
    const x = xF(gf).toFixed(1);
    out += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pT+ph}" stroke="#222630"/><text x="${x}" y="${H-7}" fill="#7d8699" font-size="11" text-anchor="middle">${gf >= 1000 ? (gf/1000)+"k" : gf}</text>`;
  }
  const step = (maxDb - minDb) <= 30 ? 5 : 10;
  for (let d = minDb; d <= maxDb + 0.01; d += step) {
    const y = yD(d).toFixed(1), z = Math.abs(d) < 0.01;
    out += `<line x1="${pL}" y1="${y}" x2="${pL+pw}" y2="${y}" stroke="${z ? "#434b5c" : "#222630"}" ${z ? 'stroke-dasharray="5,4"' : ""}/><text x="${pL-6}" y="${+y+4}" fill="#7d8699" font-size="11" text-anchor="end">${d > 0 ? "+"+d : d}</text>`;
  }
  if (prof?.curve.freqs.length) {
    const rawPts = prof.curve.freqs.map((f, i) => `${xF(f).toFixed(1)},${yD(prof.curve.raw_db[i]).toFixed(1)}`).join(" ");
    const totPts = prof.curve.freqs.map((f, i) => `${xF(f).toFixed(1)},${yD(prof.curve.total_db[i]).toFixed(1)}`).join(" ");
    const peak = Math.max(...prof.curve.total_db), col = peak > 0.1 ? "#f59e0b" : "#38bdf8";
    out += `<polyline fill="none" stroke="#6a7387" stroke-width="1.5" stroke-dasharray="2,4" points="${rawPts}"/><polyline fill="none" stroke="${col}" stroke-width="2.4" points="${totPts}"/>`;
    for (const b of prof.bands) if (b.enabled) out += `<circle cx="${xF(b.freq).toFixed(1)}" cy="${yD(b.gain).toFixed(1)}" r="4" fill="#38bdf8" stroke="#121418" stroke-width="1.5"/>`;
    out += `<text x="${pL+pw-4}" y="${pT-5}" fill="${col}" font-size="12" font-weight="600" text-anchor="end">Peak (with preamp): ${peak >= 0 ? "+" : ""}${peak.toFixed(2)} dB${peak > 0.1 ? "  [Clipping Risk — Click Auto-Preamp]" : ""}</text>`;
  }
  svg.innerHTML = out;
}
function onPlotHover(e) {
  const svg = document.getElementById("plot"); if (!svg._bounds) return;
  const r = svg.getBoundingClientRect(), b = svg._bounds;
  const x = (e.clientX - r.left) * (840 / r.width), y = (e.clientY - r.top) * (230 / r.height);
  if (x < b.pL || x > b.pL + b.pw || y < b.pT || y > b.pT + b.ph) { hoverText.textContent = ""; return; }
  const db = b.maxDb - ((y - b.pT) / b.ph) * (b.maxDb - b.minDb);
  hoverText.textContent = `${Math.round(20 * Math.pow(1000, (x - b.pL) / b.pw))} Hz  |  ${db >= 0 ? "+" : ""}${db.toFixed(1)} dB`;
}
