  const sSel = document.getElementById("sinkSel");
  sSel.innerHTML = `<option value="">Auto (follow system default)</option>` +
    st.sinks.map(s => `<option value="${escHtml(s.name)}">${escHtml(s.desc)} (${escHtml(s.name)})</option>`).join("");
