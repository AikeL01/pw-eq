"""

PAGE_BYTES = HTML.replace("__API_TOKEN_JSON__", json.dumps(SESSION_TOKEN)).encode("utf-8")


def _serialize_profile(name: str) -> dict:
    p = core.load_profile(name)
    freqs, curve = core.compute_response_curve(p)
    return {
        "name": p.name,
        "preamp": p.preamp,
        "recommended_preamp": core.recommended_preamp(p),
        "raw_text": p.raw_text,
        "warnings": p.warnings,
        "curve": [[round(f, 1), round(db, 2)] for f, db in zip(freqs, curve)],
        "bands": [
            {
                "enabled": b.enabled, "type": b.raw_type, "freq": b.freq,
                "gain": b.gain, "q": round(b.q, 3), "no_gain": b.pw_type in core.NO_GAIN_TYPES,
            }
            for b in p.bands
        ],
    }


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def _send(self, body: bytes, ctype: str, status=HTTPStatus.OK):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, obj: dict, status=HTTPStatus.OK):
        self._send(json.dumps(obj).encode("utf-8"), "application/json; charset=utf-8", status)

    def _require_token(self) -> bool:
        tok = self.headers.get("X-PW-EQ-Token", "")
        if not secrets.compare_digest(tok, SESSION_TOKEN):
            self._send_json({"ok": False, "message": "Invalid or missing session token."}, HTTPStatus.FORBIDDEN)
            return False
        return True

    def _read_json(self) -> dict:
        try:
            length = int(self.headers.get("Content-Length", "0") or 0)
        except ValueError as e:
            raise ValueError("Invalid Content-Length.") from e
        if length < 0 or length > MAX_BODY_BYTES:
            raise ValueError("Request body size out of bounds.")
        raw = self.rfile.read(length) if length > 0 else b"{}"
        data = json.loads(raw.decode("utf-8"))
        if not isinstance(data, dict):
            raise ValueError("Expected JSON object.")
        return data

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        try:
            if parsed.path == "/":
                return self._send(PAGE_BYTES, "text/html; charset=utf-8")
            if parsed.path.startswith("/api/") and not self._require_token():
                return
            if parsed.path == "/api/state":
                st = core.load_state()
                sinks, default_sink = core.get_pw_sinks_and_default()
                profiles = core.list_profiles()
                active = st.get("active_profile", "")
                if active not in profiles:
                    active = profiles[0] if profiles else ""
                conf = core.ACTIVE_CONF.read_text(encoding="utf-8") if core.ACTIVE_CONF.exists() else ""
                return self._send_json({
                    "eq_running": core.is_eq_running(),
                    "profiles": profiles,
                    "active_profile": active,
                    "target_node": st.get("target_node", ""),
                    "smart_filter": st.get("smart_filter", True),
                    "sinks": [s for s in sinks if not core.is_eq_node(s["name"])],
                    "default_sink": default_sink,
                    "service_name": core.SERVICE_NAME,
                    "profiles_dir": str(core.PROFILES_DIR),
                    "active_conf": conf,
                })
            if parsed.path == "/api/profile":
                name = urllib.parse.parse_qs(parsed.query).get("name", [""])[0]
                return self._send_json(_serialize_profile(name))
            self._send(b"Not Found", "text/plain", HTTPStatus.NOT_FOUND)
        except FileNotFoundError:
            self._send_json({"ok": False, "message": "Profile not found."}, HTTPStatus.NOT_FOUND)
        except (ValueError, KeyError) as e:
            self._send_json({"ok": False, "message": str(e)}, HTTPStatus.BAD_REQUEST)

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._require_token():
            return
        try:
            body = self._read_json()

            if path == "/api/profile/save":
                name = str(body.get("name", "")).strip() or "Untitled"
                text = str(body.get("text", ""))
                saved_path = core.save_profile_text(name, text)
                ok, msg = core.apply_profile(saved_path.stem)
                return self._send_json({"ok": ok, "message": msg}, HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST)

            if path == "/api/profile/preamp":
                name = str(body["name"])
                preamp = float(body["preamp"])
                if not math.isfinite(preamp):
                    raise ValueError("Invalid preamp value.")
                p = core.load_profile(name)
                p.preamp = preamp
                core.save_profile_text(name, core.format_eq_text(p))
                return self._send_json(_serialize_profile(name))

            if path == "/api/profile/toggle_band":
                name = str(body["name"])
                idx = int(body["index"])
                p = core.load_profile(name)
                if not (0 <= idx < len(p.bands)):
                    raise ValueError("Band index out of range.")
                p.bands[idx].enabled = not p.bands[idx].enabled
                core.save_profile_text(name, core.format_eq_text(p))
                return self._send_json(_serialize_profile(name))

            if path == "/api/profile/delete":
                name = str(body.get("name", ""))
                core.delete_profile(name)
                return self._send_json({"ok": True, "message": f"Deleted '{name}'."})

            if path == "/api/apply":
                ok, msg = core.apply_profile(str(body.get("name", "")))
                return self._send_json({"ok": ok, "message": msg}, HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST)

            if path == "/api/toggle_eq":
                if core.is_eq_running():
                    ok, msg = core.stop_eq()
                else:
                    name = str(body.get("name", "")).strip()
                    if not name:
                        return self._send_json({"ok": False, "message": "No profile selected."}, HTTPStatus.BAD_REQUEST)
                    ok, msg = core.apply_profile(name)
                return self._send_json({"ok": ok, "message": msg}, HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST)

            if path == "/api/settings":
                st = core.load_state()
                st["target_node"] = str(body.get("target_node") or "")
                st["smart_filter"] = bool(body.get("smart_filter", True))
                core.save_state(st)
                return self._send_json({"ok": True, "message": "Settings saved (click Apply to activate)."})

            if path == "/api/quit":
                self._send_json({"ok": True, "message": "Shutting down."})
                t = threading.Timer(0.1, self.server.shutdown)
                t.daemon = True
                t.start()
                return

            self._send_json({"ok": False, "message": "Not Found"}, HTTPStatus.NOT_FOUND)
        except FileNotFoundError as e:
            self._send_json({"ok": False, "message": str(e) or "Not found."}, HTTPStatus.NOT_FOUND)
        except (ValueError, KeyError, json.JSONDecodeError) as e:
            self._send_json({"ok": False, "message": str(e)}, HTTPStatus.BAD_REQUEST)


def main():
    ap = argparse.ArgumentParser(description="PipeWire Parametric EQ Local Web GUI")
    ap.add_argument("--port", type=int, default=0, help="Port to bind on 127.0.0.1 (default: random free port)")
    ap.add_argument("--no-browser", action="store_true", help="Do not open browser automatically")
    ap.add_argument("--cleanup", action="store_true", help="Stop/disable systemd service and remove config/state/profiles")
    args = ap.parse_args()

    if args.cleanup:
        for line in core.cleanup():
            print(line)
        return

    if not (0 <= args.port <= 65535):
        ap.error("--port must be between 0 and 65535")

    core.ensure_dirs()
    ThreadingHTTPServer.daemon_threads = True
    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{srv.server_port}"
    print(f"PipeWire Parametric EQ UI running at {url} (Ctrl+C to quit)")
    if not args.no_browser:
        t = threading.Timer(0.2, lambda: webbrowser.open(url))
        t.daemon = True
        t.start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
