function drawPlot(prof) {
  const svg = document.getElementById("plot"), W = 840, H = 245, pL = 48, pR = 18, pT = 26, pB = 28, pw = W - pL - pR, ph = H - pT - pB;
  let minDb = -15, maxDb = 15;
  if (prof?.curve.freqs.length) {
    const all = prof.curve.total_db.concat(prof.curve.raw_db);
    const span = Math.max(15, Math.ceil(Math.max(Math.abs(Math.max(...all)), Math.abs(Math.min(...all))) / 5) * 5);
    minDb = -span; maxDb = span;
  }
  svg._bounds = { pL, pT, pw, ph, minDb, maxDb };
  const xF = f => pL + pw * (Math.log10(Math.max(20, Math.min(20000, f)) / 20) / Math.log10(1000));
  const yD = d => pT + ph * (1 - (Math.max(minDb, Math.min(maxDb, d)) - minDb) / (maxDb - minDb));
  let out = "";
  for (const gf of [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000]) {
    const x = xF(gf).toFixed(1);
    out += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pT+ph}" stroke="#26221f"/><text x="${x}" y="${H-8}" fill="#b5a69c" font-size="11.5" text-anchor="middle">${gf >= 1000 ? (gf/1000)+"k" : gf}</text>`;
  }
  const step = (maxDb - minDb) <= 30 ? 5 : 10;
  for (let d = minDb; d <= maxDb + 0.01; d += step) {
    const y = yD(d).toFixed(1), z = Math.abs(d) < 0.01;
    out += `<line x1="${pL}" y1="${y}" x2="${pL+pw}" y2="${y}" stroke="${z ? "#5b5049" : "#26221f"}" ${z ? 'stroke-dasharray="5,4"' : ""}/><text x="${pL-8}" y="${+y+4}" fill="${z ? "#efe5de" : "#b5a69c"}" font-size="11.5" text-anchor="end">${d > 0 ? "+"+d : d}</text>`;
  }
  if (prof?.curve.freqs.length) {
    const rawPts = prof.curve.freqs.map((f, i) => `${xF(f).toFixed(1)},${yD(prof.curve.raw_db[i]).toFixed(1)}`).join(" ");
    const totPts = prof.curve.freqs.map((f, i) => `${xF(f).toFixed(1)},${yD(prof.curve.total_db[i]).toFixed(1)}`).join(" ");
    const y0 = yD(0).toFixed(1), x0 = xF(prof.curve.freqs[0]).toFixed(1), x1 = xF(prof.curve.freqs[prof.curve.freqs.length - 1]).toFixed(1);
    const peak = Math.max(...prof.curve.total_db), clip = peak > 0.1, col = clip ? "#f2b8b5" : "#eab488";
    out += `<polygon fill="${clip ? "rgba(242,184,181,0.14)" : "rgba(234,180,136,0.14)"}" points="${x0},${y0} ${totPts} ${x1},${y0}"/>`;
    out += `<polyline fill="none" stroke="#6f635b" stroke-width="1.4" stroke-dasharray="3,4" points="${rawPts}"/>`;
    out += `<polyline fill="none" stroke="${col}" stroke-width="2.5" stroke-linejoin="round" points="${totPts}"/>`;
    for (const b of prof.bands) if (b.enabled) out += `<circle cx="${xF(b.freq).toFixed(1)}" cy="${yD(b.gain).toFixed(1)}" r="4" fill="#141210" stroke="${col}" stroke-width="2"/>`;
    out += `<text x="${pL+pw-2}" y="17" fill="${col}" font-size="12.5" font-weight="600" text-anchor="end">Peak: ${peak >= 0 ? "+" : ""}${peak.toFixed(2)} dB${clip ? "  (Clipping risk)" : ""}</text>`;
  }
  svg.innerHTML = out;
}
function onPlotHover(e) {
  const svg = document.getElementById("plot"); if (!svg._bounds) return;
  const r = svg.getBoundingClientRect(), b = svg._bounds;
  const x = (e.clientX - r.left) * (840 / r.width), y = (e.clientY - r.top) * (245 / r.height);
