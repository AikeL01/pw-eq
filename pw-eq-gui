def _serialize_profile(name: str) -> dict:
    p = core.load_profile(name)
    freqs, mags = core.compute_response_curve(p)
    return {
        "name": p.name,
        "preamp": p.preamp,
        "recommended_preamp": core.recommended_preamp(p),
        "raw_text": p.raw_text,
        "freqs": freqs,
        "mags": mags,
        "bands": [
            {
                "index": i,
                "enabled": b.enabled,
                "raw_type": b.raw_type,
                "freq": b.freq,
                "gain": b.gain,
                "q": b.q,
                "no_gain": b.pw_type in core.NO_GAIN_TYPES,
            }
            for i, b in enumerate(p.bands)
        ],
    }


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        return

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, obj: dict, code: int = HTTPStatus.OK) -> None:
        self._send(code, json.dumps(obj).encode("utf-8"), "application/json; charset=utf-8")

    def _read_json(self) -> dict:
        n = int(self.headers.get("Content-Length", "0"))
        return json.loads(self.rfile.read(n).decode("utf-8")) if n else {}

    def do_GET(self) -> None:
        u = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(u.query)
        try:
            if u.path == "/":
                self._send(HTTPStatus.OK, HTML.encode("utf-8"), "text/html; charset=utf-8")
            elif u.path == "/api/state":
                state = core.load_state()
                sinks, default_sink, _ = core.get_pw_sinks_and_defaults()
                hw_sinks = [s for s in sinks if not core.is_eq_node(s["name"])]
                conf = core.ACTIVE_CONF.read_text(encoding="utf-8") if core.ACTIVE_CONF.exists() else ""
                self._send_json({
                    "running": core.is_eq_running(),
                    "profiles": core.list_profiles(),
                    "active_profile": state.get("active_profile", ""),
                    "target_node": state.get("target_node", ""),
                    "smart_filter": state.get("smart_filter", True),
                    "hw_sinks": hw_sinks,
                    "default_sink": default_sink,
                    "service": core.SERVICE_NAME,
                    "active_conf": str(core.ACTIVE_CONF),
                    "conf_preview": conf,
                })
            elif u.path == "/api/profile":
                name = qs.get("name", [""])[0]
                self._send_json(_serialize_profile(name))
            else:
                self._send(HTTPStatus.NOT_FOUND, b"Not found", "text/plain")
        except Exception as e:
            self._send(HTTPStatus.INTERNAL_SERVER_ERROR, str(e).encode("utf-8"), "text/plain")

    def do_POST(self) -> None:
        try:
            data = self._read_json()
            if self.path == "/api/profile/save":
                name, text = data["name"], data["text"]
                core.save_profile_text(name, text)
                ok, msg = core.apply_profile(name)
                self._send_json({"ok": ok, "message": msg})
            elif self.path == "/api/profile/preamp":
                name = data["name"]
                p = core.load_profile(name)
                p.preamp = float(data["preamp"])
                core.save_profile_text(name, core.format_eq_text(p))
                self._send_json(_serialize_profile(name))
            elif self.path == "/api/profile/toggle_band":
                name, idx, en = data["name"], int(data["index"]), bool(data["enabled"])
                p = core.load_profile(name)
                p.bands[idx].enabled = en
                core.save_profile_text(name, core.format_eq_text(p))
                self._send_json(_serialize_profile(name))
            elif self.path == "/api/profile/delete":
                core.delete_profile(data["name"])
                self._send_json({"ok": True, "message": f"Deleted '{data['name']}'."})
            elif self.path == "/api/apply":
                ok, msg = core.apply_profile(data["name"])
                self._send_json({"ok": ok, "message": msg})
            elif self.path == "/api/toggle_eq":
                if core.is_eq_running():
                    ok, msg = core.stop_eq()
                else:
                    name = data.get("name") or core.load_state().get("active_profile")
                    ok, msg = core.apply_profile(name) if name else (False, "Select a profile first.")
                self._send_json({"ok": ok, "message": msg})
            elif self.path == "/api/settings":
                st = core.load_state()
                st["target_node"] = data.get("target_node", "")
                st["smart_filter"] = bool(data.get("smart_filter", True))
                core.save_state(st)
                self._send_json({"ok": True, "message": "Settings saved (click Apply to rebuild config if active)."})
            elif self.path == "/api/quit":
                self._send_json({"ok": True})
                threading.Thread(target=self.server.shutdown, daemon=True).start()
            else:
                self._send(HTTPStatus.NOT_FOUND, b"Not found", "text/plain")
        except Exception as e:
            self._send(HTTPStatus.INTERNAL_SERVER_ERROR, str(e).encode("utf-8"), "text/plain")


def main() -> None:
    parser = argparse.ArgumentParser(description="PipeWire Parametric EQ Local Web UI")
    parser.add_argument("--port", type=int, default=0, help="Port to listen on (0 = auto)")
    parser.add_argument("--no-browser", action="store_true", help="Do not open browser automatically")
    args = parser.parse_args()

    core.ensure_dirs()
    if not core.list_profiles():
        core.save_profile_text(
            "Flat Reference",
            "Preamp: 0 dB\nFilter 1: ON PK Fc 1000 Hz Gain 0 dB Q 1.0\n",
        )

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}/"
    print(f"pw-eq-gui running at {url} (Ctrl+C to quit)")
    if not args.no_browser:
        threading.Timer(0.25, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
