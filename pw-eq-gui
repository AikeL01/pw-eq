  document.getElementById("bandsBody").innerHTML = prof.bands.map((b, i) => `
    <tr>
      <td>${i + 1}</td>
      <td><input type="checkbox" ${b.enabled ? "checked" : ""} onchange="toggleBand(${i})"></td>
      <td>${escHtml(b.type)}</td>
      <td class="num">${escHtml(b.freq)}</td>
      <td class="num">${b.no_gain ? "-" : escHtml(b.gain)}</td>
      <td class="num">${escHtml(b.q)}</td>
    </tr>`).join("");
  drawPlot(prof);
}

function drawPlot(prof) {
  const svg = document.getElementById("plot");
  const W = 900, H = 290, pad = { l: 42, r: 16, t: 14, b: 26 }, pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
  const yMin = -18, yMax = 18;
  const xOf = f => pad.l + (Math.log10(f) - Math.log10(20)) / 3 * pw;
  const yOf = db => pad.t + (1 - (db - yMin) / (yMax - yMin)) * ph;

  let out = `<defs><clipPath id="plotClip"><rect x="${pad.l}" y="${pad.t}" width="${pw}" height="${ph}"/></clipPath></defs>`;
  for (let db = -18; db <= 18; db += 6) {
    const y = yOf(db);
    out += `<line x1="${pad.l}" y1="${y}" x2="${W - pad.r}" y2="${y}" stroke="${db === 0 ? "#4c5268" : "#222530"}" stroke-width="${db === 0 ? 1.5 : 1}"/>`;
    out += `<text x="${pad.l - 6}" y="${y + 4}" fill="#8e95aa" font-size="10.5" text-anchor="end">${db > 0 ? "+" + db : db}</text>`;
  }
  for (const f of [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000]) {
    const x = xOf(f);
    out += `<line x1="${x}" y1="${pad.t}" x2="${x}" y2="${H - pad.b}" stroke="#222530"/>`;
    out += `<text x="${x}" y="${H - 8}" fill="#8e95aa" font-size="10.5" text-anchor="middle">${f >= 1000 ? (f / 1000) + "k" : f}</text>`;
  }

  const pts = prof.curve.map(([f, db]) => `${xOf(f).toFixed(1)},${yOf(db).toFixed(1)}`);
  const y0 = yOf(0);
  out += `<g clip-path="url(#plotClip)">`;
  out += `<polygon points="${xOf(20).toFixed(1)},${y0.toFixed(1)} ${pts.join(" ")} ${xOf(20000).toFixed(1)},${y0.toFixed(1)}" fill="rgba(168,199,250,0.14)"/>`;
  out += `<polyline fill="none" stroke="#a8c7fa" stroke-width="2.4" points="${pts.join(" ")}"/>`;
  for (const b of prof.bands) {
    if (!b.enabled || !Number.isFinite(b.freq)) continue;
    const f = Math.min(20000, Math.max(20, b.freq));
    const g = b.no_gain ? 0 : (Number.isFinite(b.gain) ? b.gain : 0);
    out += `<circle cx="${xOf(f).toFixed(1)}" cy="${yOf(g).toFixed(1)}" r="3.5" fill="#7dd88b" opacity="0.85"/>`;
  }
  out += `</g>`;
  svg.innerHTML = out;
}

function onPlotHover(e) {
  if (!currentProf) return;
  const rect = document.getElementById("plot").getBoundingClientRect();
  if (!rect.width || !rect.height) return;
  const x = ((e.clientX - rect.left) / rect.width) * 900;
  const y = ((e.clientY - rect.top) / rect.height) * 290;
  const freq = Math.pow(10, Math.log10(20) + ((x - 42) / (900 - 58)) * 3);
  const db = 18 - ((y - 14) / (290 - 40)) * 36;
  document.getElementById("hoverTxt").textContent = (freq >= 20 && freq <= 20000) ? `${Math.round(freq)} Hz | ${db >= 0 ? "+" : ""}${db.toFixed(1)} dB` : "";
}

