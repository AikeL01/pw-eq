    def _setup_tray(self) -> None:
        self.tray = QSystemTrayIcon(self)
        self.tray.setIcon(make_tray_icon(False))
        self.tray.activated.connect(self._on_tray_activated)
        self.tray_menu = QMenu()
        self._rebuild_tray_menu()
        self.tray.setContextMenu(self.tray_menu)
        if QSystemTrayIcon.isSystemTrayAvailable():
            self.tray.show()

    def _rebuild_tray_menu(self) -> None:
        self.tray_menu.clear()
        running = core.is_eq_running()
        active = core.load_state().get("active_profile", "")
        act_toggle = QAction("Disable EQ (Bypass)" if running else "Enable EQ", self)
        act_toggle.triggered.connect(self.on_toggle_eq)
        self.tray_menu.addAction(act_toggle)
        self.tray_menu.addSeparator()

        prof_menu = self.tray_menu.addMenu("Switch Profile")
        for p in core.list_profiles():
            act = QAction(p, self)
            act.setCheckable(True)
            act.setChecked(p == active and running)
            act.triggered.connect(lambda checked=False, name=p: self._switch_profile_from_tray(name))
            prof_menu.addAction(act)

        self.tray_menu.addSeparator()
        act_show = QAction("Open Window", self)
        act_show.triggered.connect(self._show_window)
        act_quit = QAction("Quit Tray App", self)
        act_quit.triggered.connect(QApplication.quit)
        self.tray_menu.addAction(act_show)
        self.tray_menu.addAction(act_quit)

    def _on_tray_activated(self, reason) -> None:
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.hide() if self.isVisible() else self._show_window()

    def _show_window(self) -> None:
        self.show()
        self.raise_()
        self.activateWindow()

    def closeEvent(self, event) -> None:
        if QSystemTrayIcon.isSystemTrayAvailable():
            event.ignore()
            self.hide()
        else:
            event.accept()

    def dragEnterEvent(self, event: QDragEnterEvent) -> None:
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event: QDropEvent) -> None:
        for url in event.mimeData().urls():
            p = Path(url.toLocalFile())
            if p.is_file():
                self._import_path(p)
                break

    def _reload_sinks(self) -> None:
        self._updating_ui = True
        state = core.load_state()
        saved_target = state.get("target_node", "")
        self.smart_cb.setChecked(state.get("smart_filter", True))
        self.sink_combo.clear()
        self.sink_combo.addItem("Auto (Follow Default Hardware Output)", "")
        sinks, _, _ = core.get_pw_sinks_and_defaults()
        sel_idx = 0
        for s in sinks:
            if core.is_eq_node(s["name"]):
                continue
            self.sink_combo.addItem(s["description"], s["name"])
            if s["name"] == saved_target:
                sel_idx = self.sink_combo.count() - 1
        self.sink_combo.setCurrentIndex(sel_idx)
        self._updating_ui = False

    def _reload_profiles(self, select_name: str | None = None) -> None:
        self._updating_ui = True
        profiles = core.list_profiles()
        target = select_name or core.load_state().get("active_profile", "")
        self.profile_combo.clear()
        self.profile_combo.addItems(profiles)
        if target in profiles:
            self.profile_combo.setCurrentText(target)
        elif profiles:
            self.profile_combo.setCurrentIndex(0)
        self._updating_ui = False

        if self.profile_combo.currentText():
            self._load_selected_profile(self.profile_combo.currentText())
        else:
            self._current_profile = None
            self.bands_table.setRowCount(0)
            self.raw_edit.clear()
            self.plot.set_profile(core.EQProfile("Empty"))

    def _load_selected_profile(self, name: str) -> None:
        if not name:
            return
        try:
            prof = core.load_profile(name)
        except Exception as exc:
            self.status_bar.showMessage(f"Error loading {name}: {exc}")
            return
        self._current_profile = prof
        self._updating_ui = True
        self.preamp_spin.setValue(prof.preamp)
        self.raw_edit.setPlainText(prof.raw_text)
        self.bands_table.setRowCount(len(prof.bands))
        for r, b in enumerate(prof.bands):
            chk = QTableWidgetItem()
            chk.setFlags(Qt.ItemFlag.ItemIsUserCheckable | Qt.ItemFlag.ItemIsEnabled | Qt.ItemFlag.ItemIsSelectable)
            chk.setCheckState(Qt.CheckState.Checked if b.enabled else Qt.CheckState.Unchecked)
            self.bands_table.setItem(r, 0, chk)
            vals = [b.raw_type, f"{b.freq:.1f}", f"{b.gain:+.2f}" if b.pw_type not in core.NO_GAIN_TYPES else "—", f"{b.q:.3f}"]
            for c, val in enumerate(vals, start=1):
                it = QTableWidgetItem(val)
                it.setFlags(Qt.ItemFlag.ItemIsEnabled | Qt.ItemFlag.ItemIsSelectable)
                self.bands_table.setItem(r, c, it)
        self._updating_ui = False
        self.plot.set_profile(prof)
        self.status_bar.showMessage(" | ".join(prof.warnings[:2]) if prof.warnings else f"Loaded '{name}' ({len(prof.bands)} bands)")

    def _refresh_status(self) -> None:
        running = core.is_eq_running()
        active = core.load_state().get("active_profile", "")
        self.toggle_btn.setText(f"EQ: ON ({active})" if (running and active) else ("EQ: ON" if running else "EQ: OFF (Bypassed)"))
        self.toggle_btn.setObjectName("toggleOn" if running else "toggleOff")
        self.toggle_btn.style().unpolish(self.toggle_btn)
        self.toggle_btn.style().polish(self.toggle_btn)
        self.tray.setIcon(make_tray_icon(running))
        self.tray.setToolTip(f"PipeWire EQ: {'ON — ' + active if running else 'OFF'}")
        self._rebuild_tray_menu()
        self._refresh_conf_preview()

    def _refresh_conf_preview(self) -> None:
        self.conf_preview.setPlainText(core.ACTIVE_CONF.read_text(encoding="utf-8") if core.ACTIVE_CONF.exists() else "(No active.conf generated yet)")

    def _run_bg(self, fn, *args, **kwargs) -> None:
        if self._worker and self._worker.isRunning():
            return
        self.apply_btn.setEnabled(False)
        self.toggle_btn.setEnabled(False)
        self.status_bar.showMessage("Updating PipeWire filter-chain...")
        self._worker = WorkerThread(fn, *args, **kwargs)
        self._worker.finished.connect(self._on_bg_done)
        self._worker.start()

    def _on_bg_done(self, ok: bool, msg: str) -> None:
        self.apply_btn.setEnabled(True)
        self.toggle_btn.setEnabled(True)
        self.status_bar.showMessage(msg)
        self._refresh_status()
        if not ok:
            QMessageBox.warning(self, "PipeWire EQ Error", msg)

    def _switch_profile_from_tray(self, name: str) -> None:
        self._reload_profiles(select_name=name)
        self._run_bg(core.apply_profile, name)

    def on_profile_selected(self, name: str) -> None:
        if not self._updating_ui and name:
            self._load_selected_profile(name)

    def on_sink_changed(self) -> None:
        if not self._updating_ui:
            state = core.load_state()
            state["target_node"] = self.sink_combo.currentData() or ""
            core.save_state(state)

    def on_smart_toggled(self, checked: bool) -> None:
        if not self._updating_ui:
            state = core.load_state()
            state["smart_filter"] = checked
            core.save_state(state)

    def on_preamp_changed(self, val: float) -> None:
        if not self._updating_ui and self._current_profile:
            self._current_profile.preamp = val
            self._sync_profile_to_disk()

    def on_auto_preamp(self) -> None:
        if self._current_profile:
            self.preamp_spin.setValue(core.recommended_preamp(self._current_profile))

    def on_band_item_changed(self, item: QTableWidgetItem) -> None:
        if not self._updating_ui and self._current_profile and item.column() == 0:
            row = item.row()
            if 0 <= row < len(self._current_profile.bands):
                self._current_profile.bands[row].enabled = item.checkState() == Qt.CheckState.Checked
                self._sync_profile_to_disk()

    def _sync_profile_to_disk(self) -> None:
        if not self._current_profile:
            return
        new_text = core.format_eq_text(self._current_profile)
        self._current_profile.raw_text = new_text
        self._updating_ui = True
        self.raw_edit.setPlainText(new_text)
        self._updating_ui = False
        core.save_profile_text(self._current_profile.name, new_text)
        self.plot.set_profile(self._current_profile)

    def on_save_raw_and_apply(self) -> None:
        name = self.profile_combo.currentText()
        if not name:
            name, ok = QInputDialog.getText(self, "Profile Name", "Enter a name for this EQ profile:")
            if not ok or not name.strip():
                return
            name = name.strip()
        core.save_profile_text(name, self.raw_edit.toPlainText())
        self._reload_profiles(select_name=name)
        self._run_bg(core.apply_profile, name)

    def on_apply_clicked(self) -> None:
        name = self.profile_combo.currentText()
        if not name:
            QMessageBox.information(self, "No Profile", "Import or paste an EQ.txt first.")
            return
        self._run_bg(core.apply_profile, name)

    def on_toggle_eq(self) -> None:
        if core.is_eq_running():
            self._run_bg(core.stop_eq)
        else:
            name = self.profile_combo.currentText() or core.load_state().get("active_profile", "")
            if not name:
                QMessageBox.information(self, "No Profile", "Import an EQ.txt profile first.")
                return
            self._run_bg(core.apply_profile, name)

    def _import_path(self, path: Path) -> None:
        text = path.read_text(encoding="utf-8", errors="replace")
        name, ok = QInputDialog.getText(self, "Import EQ.txt", "Profile name:", text=path.stem)
        if not ok or not name.strip():
            return
        name = name.strip()
        core.save_profile_text(name, text)
        self._reload_profiles(select_name=name)
        self._run_bg(core.apply_profile, name)

    def on_import_file(self) -> None:
        file_path, _ = QFileDialog.getOpenFileName(
            self, "Import Parametric EQ.txt", str(Path.home()), "EQ Files (*.txt *.apo);;All Files (*)"
        )
        if file_path:
            self._import_path(Path(file_path))

    def on_paste_clipboard(self) -> None:
        text = QApplication.clipboard().text()
        if not text.strip():
            QMessageBox.information(self, "Empty Clipboard", "Copy your EQ.txt text first.")
            return
        if not core.parse_eq_text(text).bands:
            QMessageBox.warning(self, "No Filters Found", "Clipboard text did not contain valid Equalizer APO Filter lines.")
            return
        name, ok = QInputDialog.getText(self, "Save Pasted EQ", "Profile name:")
        if not ok or not name.strip():
            return
        name = name.strip()
        core.save_profile_text(name, text)
        self._reload_profiles(select_name=name)
        self._run_bg(core.apply_profile, name)

    def on_delete_profile(self) -> None:
        name = self.profile_combo.currentText()
        if not name:
            return
        if QMessageBox.question(self, "Delete Profile", f"Delete '{name}'?") == QMessageBox.StandardButton.Yes:
            was_active = core.is_eq_running() and core.load_state().get("active_profile") == name
            core.delete_profile(name)
            if was_active:
                self._run_bg(core.stop_eq)
            self._reload_profiles()


def main() -> int:
    app = QApplication(sys.argv)
    app.setStyleSheet(DARK_QSS)
    if QSystemTrayIcon.isSystemTrayAvailable():
        app.setQuitOnLastWindowClosed(False)
    win = MainWindow(start_in_tray=("--tray" in sys.argv))
    if "--tray" not in sys.argv:
        win.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
