def make_tray_icon(active: bool) -> QIcon:
    pix = QPixmap(64, 64)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor("#198754") if active else QColor("#49505e"))
    p.setPen(Qt.PenStyle.NoPen)
    p.drawRoundedRect(4, 4, 56, 56, 14, 14)
    p.setPen(QPen(QColor("#ffffff"), 5, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
    for x1, y1, x2, y2 in ((18, 44, 18, 24), (32, 44, 32, 16), (46, 44, 46, 28)):
        p.drawLine(x1, y1, x2, y2)
    p.end()
    return QIcon(pix)


class ResponsePlot(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(210)
        self.freqs: List[float] = []
        self.raw_db: List[float] = []
        self.total_db: List[float] = []
        self.bands: List[core.EQBand] = []

    def set_profile(self, profile: core.EQProfile) -> None:
        self.freqs, self.raw_db, self.total_db = core.compute_response_curve(profile)
        self.bands = profile.bands
        self.update()

    def paintEvent(self, event) -> None:
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        pad_l, pad_r, pad_t, pad_b = 44, 16, 16, 26
        pw, ph = max(10, w - pad_l - pad_r), max(10, h - pad_t - pad_b)
        p.fillRect(self.rect(), QColor("#121418"))

        min_db, max_db = -15.0, 15.0
        if self.total_db or self.raw_db:
            all_vals = self.total_db + self.raw_db
            span = max(15.0, math.ceil(max(abs(max(all_vals)), abs(min(all_vals))) / 5.0) * 5.0)
            min_db, max_db = -span, span

        def x_for_freq(f: float) -> float:
            f = max(20.0, min(20000.0, f))
            return pad_l + pw * (math.log10(f / 20.0) / math.log10(20000.0 / 20.0))

        def y_for_db(db: float) -> float:
            db = max(min_db, min(max_db, db))
            return pad_t + ph * (1.0 - (db - min_db) / (max_db - min_db))

        p.setFont(QFont("Inter", 9))
        for gf in (20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000):
            x = x_for_freq(gf)
            p.setPen(QPen(QColor("#222630"), 1))
            p.drawLine(int(x), pad_t, int(x), pad_t + ph)
            p.setPen(QColor("#7d8699"))
            p.drawText(int(x) - 14, h - 6, 28, 16, Qt.AlignmentFlag.AlignCenter, f"{gf // 1000}k" if gf >= 1000 else str(gf))

        step = 5.0 if (max_db - min_db) <= 30.0 else 10.0
        db_val = min_db
        while db_val <= max_db + 0.01:
            y = y_for_db(db_val)
            p.setPen(QPen(QColor("#434b5c"), 1.5, Qt.PenStyle.DashLine) if abs(db_val) < 0.01 else QPen(QColor("#222630"), 1))
            p.drawLine(pad_l, int(y), pad_l + pw, int(y))
            p.setPen(QColor("#7d8699"))
            p.drawText(2, int(y) - 8, pad_l - 6, 16, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, f"{int(db_val):+d}")
            db_val += step

        if not self.freqs:
            return

        raw_path = QPainterPath()
        for i, (f, db) in enumerate(zip(self.freqs, self.raw_db)):
            pt = QPointF(x_for_freq(f), y_for_db(db))
            raw_path.moveTo(pt) if i == 0 else raw_path.lineTo(pt)
        p.setPen(QPen(QColor("#6a7387"), 1.5, Qt.PenStyle.DotLine))
        p.drawPath(raw_path)

        tot_path = QPainterPath()
        for i, (f, db) in enumerate(zip(self.freqs, self.total_db)):
            pt = QPointF(x_for_freq(f), y_for_db(db))
            tot_path.moveTo(pt) if i == 0 else tot_path.lineTo(pt)

        peak = max(self.total_db)
        curve_color = QColor("#f59e0b") if peak > 0.1 else QColor("#38bdf8")
        p.setPen(QPen(curve_color, 2.4))
        p.drawPath(tot_path)

        for b in self.bands:
            if b.enabled:
                p.setBrush(QColor("#38bdf8"))
                p.setPen(QPen(QColor("#121418"), 1.5))
                p.drawEllipse(QPointF(x_for_freq(b.freq), y_for_db(b.gain)), 4.0, 4.0)

        badge = f"Peak (with preamp): {peak:+.2f} dB" + ("  [Clipping Risk — Click Auto-Preamp]" if peak > 0.1 else "")
        p.setPen(curve_color)
        p.setFont(QFont("Inter", 10, QFont.Weight.DemiBold))
        p.drawText(pad_l + 8, pad_t + 2, pw - 16, 18, Qt.AlignmentFlag.AlignRight, badge)


class WorkerThread(QThread):
    finished = pyqtSignal(bool, str)

    def __init__(self, fn, *args, **kwargs):
        super().__init__()
        self.fn, self.args, self.kwargs = fn, args, kwargs

    def run(self) -> None:
        try:
            ok, msg = self.fn(*self.args, **self.kwargs)
        except Exception as exc:
            ok, msg = False, str(exc)
        self.finished.emit(ok, msg)


