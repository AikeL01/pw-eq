def _serialize_profile(prof: core.EQProfile) -> dict:
    freqs, raw_db, total_db = core.compute_response_curve(prof)
    return {
        "name": prof.name, "preamp": prof.preamp, "raw_text": prof.raw_text, "warnings": prof.warnings,
        "bands": [{"enabled": b.enabled, "raw_type": b.raw_type, "freq": b.freq, "gain": b.gain, "q": b.q, "has_gain": b.pw_type not in core.NO_GAIN_TYPES} for b in prof.bands],
        "curve": {"freqs": freqs, "raw_db": raw_db, "total_db": total_db, "recommended_preamp": core.recommended_preamp(prof)},
    }


class Handler(BaseHTTPRequestHandler):
    def log_message(self, format: str, *args) -> None:
        return

    def _send(self, raw: bytes, ctype: str, status: int = HTTPStatus.OK) -> None:
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _send_json(self, data: dict, status: int = HTTPStatus.OK) -> None:
        self._send(json.dumps(data).encode("utf-8"), "application/json; charset=utf-8", status)

    def _read_json(self) -> dict:
        n = int(self.headers.get("Content-Length", "0"))
        return json.loads(self.rfile.read(n).decode("utf-8")) if n else {}

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/":
            self._send(HTML.encode("utf-8"), "text/html; charset=utf-8")
        elif parsed.path == "/api/state":
            sinks, _, _ = core.get_pw_sinks_and_defaults()
            self._send_json({
                "running": core.is_eq_running(), "state": core.load_state(), "profiles": core.list_profiles(),
                "sinks": [s for s in sinks if not core.is_eq_node(s["name"])],
                "active_conf": core.ACTIVE_CONF.read_text(encoding="utf-8") if core.ACTIVE_CONF.exists() else "",
                "profiles_dir": str(core.PROFILES_DIR), "service_name": core.SERVICE_NAME,
            })
        elif parsed.path == "/api/profile":
            name = urllib.parse.parse_qs(parsed.query).get("name", [""])[0]
            if not name or name not in core.list_profiles():
                self._send_json({"error": "Profile not found"}, HTTPStatus.NOT_FOUND)
            else:
                self._send_json(_serialize_profile(core.load_profile(name)))
        else:
            self.send_error(HTTPStatus.NOT_FOUND)

    def do_POST(self) -> None:
        b = self._read_json()
        if self.path == "/api/profile/save":
            name, text = b.get("name", "").strip(), b.get("text", "")
            if not name:
                self._send_json({"ok": False, "message": "Missing profile name"})
                return
            core.save_profile_text(name, text)
            ok, msg = core.apply_profile(name) if b.get("apply") else (True, f"Saved '{name}'")
            self._send_json({"ok": ok, "message": msg})
        elif self.path == "/api/profile/preamp":
            prof = core.load_profile(b["name"])
            prof.preamp = float(b["preamp"])
            prof.raw_text = core.format_eq_text(prof)
            core.save_profile_text(prof.name, prof.raw_text)
            self._send_json(_serialize_profile(prof))
        elif self.path == "/api/profile/toggle_band":
            prof = core.load_profile(b["name"])
            idx = int(b["index"])
            if 0 <= idx < len(prof.bands):
                prof.bands[idx].enabled = bool(b["enabled"])
                prof.raw_text = core.format_eq_text(prof)
                core.save_profile_text(prof.name, prof.raw_text)
            self._send_json(_serialize_profile(prof))
        elif self.path == "/api/profile/delete":
            name = b.get("name", "")
            was_active = core.is_eq_running() and core.load_state().get("active_profile") == name
            core.delete_profile(name)
            if was_active:
                core.stop_eq()
            self._send_json({"ok": True, "message": f"Deleted '{name}'"})
        elif self.path == "/api/apply":
            ok, msg = core.apply_profile(b["name"])
            self._send_json({"ok": ok, "message": msg})
        elif self.path == "/api/toggle_eq":
            if core.is_eq_running():
                ok, msg = core.stop_eq()
            else:
                name = b.get("name") or core.load_state().get("active_profile", "")
                ok, msg = core.apply_profile(name) if name else (False, "No profile selected")
            self._send_json({"ok": ok, "message": msg})
        elif self.path == "/api/settings":
            state = core.load_state()
            state["target_node"], state["smart_filter"] = b.get("target_node", ""), bool(b.get("smart_filter", True))
            core.save_state(state)
            self._send_json({"ok": True, "message": "Saved output settings (click Apply to reload)"})
        elif self.path == "/api/quit":
            self._send_json({"ok": True})
            threading.Thread(target=self.server.shutdown, daemon=True).start()
        else:
            self.send_error(HTTPStatus.NOT_FOUND)


def main() -> int:
    ap = argparse.ArgumentParser(prog="pw-eq-gui", description="Local Web UI for pw-eq")
    ap.add_argument("--port", type=int, default=0, help="Port to listen on (default: auto)")
    ap.add_argument("--no-browser", action="store_true", help="Do not auto-open browser")
    args = ap.parse_args()
    core.ensure_dirs()
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}"
    print(f"pw-eq-gui running at {url} (Press Ctrl+C to stop)")
    if not args.no_browser:
        threading.Timer(0.15, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
