function drawPlot(prof) {
  const svg = document.getElementById("plot"), W = 840, H = 245, pL = 44, pR = 16, pT = 24, pB = 26, pw = W - pL - pR, ph = H - pT - pB;
  let minDb = -15, maxDb = 15;
  if (prof?.curve.freqs.length) {
    const all = prof.curve.total_db.concat(prof.curve.raw_db);
    const span = Math.max(15, Math.ceil(Math.max(Math.abs(Math.max(...all)), Math.abs(Math.min(...all))) / 5) * 5);
    minDb = -span; maxDb = span;
  }
  svg._bounds = { pL, pT, pw, ph, minDb, maxDb };
  const xF = f => pL + pw * (Math.log10(Math.max(20, Math.min(20000, f)) / 20) / Math.log10(1000));
  const yD = d => pT + ph * (1 - (Math.max(minDb, Math.min(maxDb, d)) - minDb) / (maxDb - minDb));
  let out = "";
  for (const mf of [30, 40, 60, 70, 80, 90, 300, 400, 600, 700, 800, 900, 3000, 4000, 6000, 7000, 8000, 9000]) {
    const x = xF(mf).toFixed(1);
    out += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pT+ph}" stroke="#121216"/>`;
  }
  for (const gf of [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000]) {
    const x = xF(gf).toFixed(1);
    out += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pT+ph}" stroke="#1d1d23"/>`;
    out += `<text x="${x}" y="${H-8}" fill="#6e6e78" font-family="monospace" font-size="10.5" text-anchor="middle">${gf >= 1000 ? (gf/1000)+"k" : gf}</text>`;
  }
  const step = (maxDb - minDb) <= 30 ? 5 : 10;
  for (let d = minDb; d <= maxDb + 0.01; d += step) {
    const y = yD(d).toFixed(1), z = Math.abs(d) < 0.01;
    out += `<line x1="${pL}" y1="${y}" x2="${pL+pw}" y2="${y}" stroke="${z ? "#3a3a44" : "#1b1b21"}" ${z ? 'stroke-dasharray="4,3"' : ""}/>`;
    out += `<text x="${pL-7}" y="${+y+3.5}" fill="${z ? "#a1a1aa" : "#6e6e78"}" font-family="monospace" font-size="10.5" text-anchor="end">${d > 0 ? "+"+d : d}</text>`;
  }
  if (prof?.curve.freqs.length) {
    const rawPts = prof.curve.freqs.map((f, i) => `${xF(f).toFixed(1)},${yD(prof.curve.raw_db[i]).toFixed(1)}`).join(" ");
    const totPts = prof.curve.freqs.map((f, i) => `${xF(f).toFixed(1)},${yD(prof.curve.total_db[i]).toFixed(1)}`).join(" ");
    const y0 = yD(0).toFixed(1), x0 = xF(prof.curve.freqs[0]).toFixed(1), x1 = xF(prof.curve.freqs[prof.curve.freqs.length - 1]).toFixed(1);
    const peak = Math.max(...prof.curve.total_db), clip = peak > 0.1, col = clip ? "#ef4444" : "#ff8a1f";
    out += `<polygon fill="${clip ? "rgba(239,68,68,0.12)" : "rgba(255,138,31,0.11)"}" points="${x0},${y0} ${totPts} ${x1},${y0}"/>`;
    out += `<polyline fill="none" stroke="#52525b" stroke-width="1.2" stroke-dasharray="2,3" points="${rawPts}"/>`;
    out += `<polyline fill="none" stroke="${col}" stroke-width="2" points="${totPts}"/>`;
    for (const b of prof.bands) if (b.enabled) out += `<circle cx="${xF(b.freq).toFixed(1)}" cy="${yD(b.gain).toFixed(1)}" r="3.2" fill="#09090b" stroke="${col}" stroke-width="1.6"/>`;
    out += `<text x="${pL+pw-2}" y="15" fill="${col}" font-family="monospace" font-size="11" font-weight="600" text-anchor="end">PEAK ${peak >= 0 ? "+" : ""}${peak.toFixed(2)} dB${clip ? " [CLIP]" : ""}</text>`;
  }
  svg.innerHTML = out;
}
function onPlotHover(e) {
  const svg = document.getElementById("plot"); if (!svg._bounds) return;
  const r = svg.getBoundingClientRect(), b = svg._bounds;
  const x = (e.clientX - r.left) * (840 / r.width), y = (e.clientY - r.top) * (245 / r.height);
  if (x < b.pL || x > b.pL + b.pw || y < b.pT || y > b.pT + b.ph) { hoverText.textContent = ""; return; }
