async function api(url, body = null) {
  const headers = { "X-PW-EQ-Token": API_TOKEN };
  const opts = { headers };
  if (body !== null) {
    headers["Content-Type"] = "application/json";
    opts.method = "POST";
    opts.body = JSON.stringify(body);
  }
  const r = await fetch(url, opts);
  let data = null;
  try { data = await r.json(); } catch {}
  if (!r.ok) {
    const msg = (data && data.message) || r.statusText || "Request failed";
    setStatus("Error: " + msg);
    throw new Error(msg);
  }
  return data;
}

